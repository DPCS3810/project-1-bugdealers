        <widget class="QProgressBar" name="progressBar">
         <property name="styleSheet">
          <string notr="true">/* ProgressBar overall background */
QProgressBar {
border: 2px solid #555; /* border around the bar */
border-radius: 5px; /* rounded corners */
background-color: #f0f0f0; /* color of the empty part */
text-align: center; /* center the percentage text */
font-weight: bold; /* make text bold */
}
QProgressBar::chunk {
background-color: qlineargradient(
x1:0, y1:0, x2:1, y2:0, /* left to right gradient */
stop:0 #CCEBEB, /* start color */
stop:1 #47B8B8 /* end color */
);
border-radius: 5px; /* rounded edges for smooth fill */
}
</string>
